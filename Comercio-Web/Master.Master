                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="Comercio_Web.Master" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Comercio Web</title>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Comercio Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item" runat="server" id="navInventario">
                            <a class="nav-link" href="MarcasLista.aspx">Inventario</a>
                        </li>
                        <li class="nav-item" runat="server" id="navUsuarios">
                            <a class="nav-link" href="UsuariosLista.aspx">Usuarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="ClientesLista.aspx">Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="VentasLista.aspx">Ventas</a>
                        </li>
                        <li class="nav-item" runat="server" id="navReportes">
                            <a class="nav-link" href="Reportes.aspx">Reportes</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <asp:Label ID="lblUsuario" runat="server" CssClass="text-white" />
                        <asp:Button ID="btnSalir" runat="server" Text="Salir"
                            CssClass="btn btn-outline-light btn-sm" OnClick="btnSalir_Click"
                            UseSubmitBehavior="false" CausesValidation="false" />
                    </div>
                </div>
            </div>
        </nav>
        <asp:Panel ID="pnlInventarioSidebar" runat="server" CssClass="position-fixed top-0 start-0 bg-light border-end" style="width: 250px; height: calc(100vh - 56px); margin-top: 56px; z-index: 1020; overflow-y: auto;">
            <div class="card border-0 rounded-0 h-100">
                <div class="card-header py-3 bg-white border-bottom">
                    <span class="fw-bold fs-5 text-uppercase">Inventario</span>
                </div>
                <div class="list-group list-group-flush">
                    <a id="lnkSidebarMarcas" runat="server" href="MarcasLista.aspx" class="list-group-item list-group-item-action py-3 fw-semibold fs-6">Marcas</a>
                    <a id="lnkSidebarCategorias" runat="server" href="CategoriasLista.aspx" class="list-group-item list-group-item-action py-3 fw-semibold fs-6">Categorías</a>
                    <a id="lnkSidebarProveedores" runat="server" href="ProveedoresLista.aspx" class="list-group-item list-group-item-action py-3 fw-semibold fs-6">Proveedores</a>
                    <a id="lnkSidebarProductos" runat="server" href="ProductosLista.aspx" class="list-group-item list-group-item-action py-3 fw-semibold fs-6">Productos</a>
                    <a id="lnkSidebarCompras" runat="server" href="ComprasLista.aspx" class="list-group-item list-group-item-action py-3 fw-semibold fs-6">Compras</a>
                </div>
            </div>
        </asp:Panel>

        <div class="container-xl mt-4">
            <div id="contenedorContenido" runat="server" class="w-100">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
